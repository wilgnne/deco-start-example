{
  "name": "deco-start-example/site",
  "version": "0.1.0",
  "type": "module",
  "description": "deco.cx v2 storefront powered by TanStack Start",
  "scripts": {
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "build": "pnpm run generate && vite build",
    "generate": "pnpm run generate:blocks && pnpm run generate:schema && pnpm run generate:sections && pnpm run generate:loaders",
    "generate:blocks": "tsx node_modules/@decocms/start/scripts/generate-blocks.ts",
    "generate:schema": "tsx node_modules/@decocms/start/scripts/generate-schema.ts --site deco-start-example",
    "generate:sections": "tsx node_modules/@decocms/start/scripts/generate-sections.ts",
    "generate:loaders": "tsx node_modules/@decocms/start/scripts/generate-loaders.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
     "@decocms/apps": "5.2.0",
    "@decocms/start": "6.12.1",
    "@tanstack/react-router": "1.166.7",
    "@tanstack/react-start": "1.166.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  }
}
