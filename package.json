{
  "name": "deco-start-example",
  "version": "0.1.0",
  "type": "module",
  "description": "deco.cx v2 storefront powered by TanStack Start",
  "scripts": {
    "dev": "vite dev",
    "generate:blocks": "tsx node_modules/@decocms/start/scripts/generate-blocks.ts",
    "generate:schema": "tsx node_modules/@decocms/start/scripts/generate-schema.ts --site deco-start-example",
    "build": "npm run generate:blocks && npm run generate:schema && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decocms/apps": "^5.4.0",
    "@decocms/start": "^6.30.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
